{
  "name": "tiny-expr-parser",
  "description": "A tiny, zero-dependency expression parser library.",
  "version": "0.0.1-beta.0",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "start": "rolldown --config rolldown.config.mjs --watch",
    "build": "rolldown --config rolldown.config.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [
    "expression",
    "parser",
    "ast",
    "expression-parser",
    "operator",
    "zero-dependency"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://github.com/peakchen90/tiny-expr-parser",
  "bugs": {
    "url": "https://github.com/peakchen90/tiny-expr-parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peakchen90/tiny-expr-parser.git"
  },
  "author": "peakchen90 <1558267774@qq.com>",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.ZH-CN.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "rolldown": "1.2.14",
    "rolldown-plugin-dts": "0.28.8",
    "semver": "7.8.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
